<?xml version="1.0" encoding="utf-8"?>
<ScrollView
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="#F6F8F7"
  android:fillViewport="true">
  <androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
      android:id="@+id/rootContainer"
      android:orientation="vertical"
      android:padding="@dimen/page_margin"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      app:layout_constraintWidth_max="720dp"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintTop_toTopOf="parent">
      <TextView
        android:id="@+id/tvAppTitle"
        style="@style/TextTitleLarge"
        android:text="@string/title_meteo_citation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
      <Spinner
        android:id="@+id/spinnerCities"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginTop="@dimen/space_small"
        android:contentDescription="@string/selected_city" />
      <com.valerie.meteoquote.ui.SearchActionsRow
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">
        <EditText
          android:id="@+id/etCitySearch"
          style="@style/TextBody"
          android:layout_width="0dp"
          android:layout_weight="1"
          android:layout_height="wrap_content"
          android:minHeight="48dp"
          android:hint="@string/search_city"
          android:inputType="textCapWords|textMultiLine"
          android:importantForAutofill="no"
          android:scrollHorizontally="false"
          android:singleLine="false"
          android:maxLines="3"
          android:textColorHint="#52646B" />
        <LinearLayout
          android:layout_width="wrap_content"
          android:layout_height="wrap_content">
          <Button
            android:id="@+id/btnAddCity"
            style="@style/ActionIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/add_city"
            app:icon="@drawable/ic_add" />
          <Button
            android:id="@+id/btnLocate"
            style="@style/ActionIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/use_location"
            app:icon="@drawable/sharp_my_location_24" />
          <Button
            android:id="@+id/btnDeleteCity"
            style="@style/ActionIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/delete_city"
            app:icon="@drawable/ic_delete"
            app:iconTint="@color/destructive_tint" />
        </LinearLayout>
      </com.valerie.meteoquote.ui.SearchActionsRow>
      <HorizontalScrollView
        android:id="@+id/recentChipsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="horizontal">
        <LinearLayout
          android:id="@+id/containerRecentChips"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:orientation="horizontal"></LinearLayout>
      </HorizontalScrollView>
      <LinearLayout
        android:id="@+id/weatherBlock"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/space_medium"
        android:layout_marginTop="@dimen/space_medium"
        android:background="@drawable/bg_surface">
        <TextView
          style="@style/TextSectionTitle"
          android:text="@string/current_weather"
          android:accessibilityHeading="true"
          android:layout_width="match_parent"
          android:layout_height="wrap_content" />
        <com.valerie.meteoquote.ui.CurrentWeatherRow
          android:id="@+id/currentWeatherRow"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:layout_width="match_parent"
          android:layout_height="wrap_content">
          <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:importantForAccessibility="no" />
          <TextView
            android:id="@+id/tvTemp"
            android:text="@string/empty_temperature"
            android:textSize="48sp"
            android:textColor="#203A43"
            android:fontFamily="sans-serif-light"
            android:layout_marginStart="@dimen/space_small"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content" />
        </com.valerie.meteoquote.ui.CurrentWeatherRow>
        <TextView
          android:id="@+id/tvCondition"
          style="@style/TextBody"
          android:text="@string/empty_value"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:accessibilityLiveRegion="polite" />
        <Button
          android:id="@+id/btnRetry"
          style="@style/ActionSecondary"
          android:text="@string/retry"
          android:visibility="gone"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content" />
        <LinearLayout
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:layout_width="match_parent"
          android:layout_height="wrap_content">
          <TextView
            android:id="@+id/tvUpdated"
            style="@style/TextSecondary"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite" />
          <Button
            android:id="@+id/btnRefresh"
            style="@style/ActionIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/refresh"
            app:icon="@drawable/ic_refresh" />
        </LinearLayout>
      </LinearLayout>
      <com.valerie.meteoquote.ui.MetricLayout
        android:id="@+id/containerChips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_medium">
        <include
          android:id="@+id/uvCard"
          layout="@layout/item_metric" />
        <include
          android:id="@+id/aqiCard"
          layout="@layout/item_metric" />
      </com.valerie.meteoquote.ui.MetricLayout>
      <TextView
        android:id="@+id/tvHourlyTitle"
        style="@style/SectionHeading"
        android:text="@string/hourly_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
      <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="horizontal"
        android:fadeScrollbars="false"
        android:scrollbarSize="2dp"
        android:paddingBottom="@dimen/space_small">
        <LinearLayout
          android:id="@+id/containerHourly"
          android:orientation="horizontal"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:paddingTop="@dimen/space_small"
          android:paddingBottom="@dimen/space_small" />
      </HorizontalScrollView>
      <TextView
        android:id="@+id/tvDailyTitle"
        style="@style/SectionHeading"
        android:text="@string/daily_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
      <LinearLayout
        android:id="@+id/containerDaily"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/space_small"
        android:paddingBottom="@dimen/space_small" />
      <LinearLayout
        android:id="@+id/quoteBlock"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_section"
        android:padding="@dimen/space_large">
        <TextView
          android:id="@+id/tvQuoteTitle"
          style="@style/TextSectionTitle"
          android:accessibilityHeading="true"
          android:text="@string/quote_title"
          android:layout_width="match_parent"
          android:layout_height="wrap_content" />
        <TextView
          android:id="@+id/tvQuoteMood"
          style="@style/TextSecondary"
          android:text="@string/quote_mood"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/space_small" />
        <TextView
          android:text="@string/quote_mark"
          android:textSize="56sp"
          android:fontFamily="serif"
          android:textColor="#476570"
          android:importantForAccessibility="no"
          android:layout_width="match_parent"
          android:layout_height="wrap_content" />
        <TextView
          android:id="@+id/tvQuote"
          android:text="@string/empty_value"
          android:textSize="24sp"
          android:fontFamily="serif"
          android:textColor="#203A43"
          android:lineSpacingMultiplier="1.2"
          android:layout_width="match_parent"
          android:layout_height="wrap_content" />
        <TextView
          android:id="@+id/tvQuoteAuthor"
          style="@style/TextBody"
          android:layout_marginTop="@dimen/space_medium"
          android:layout_width="match_parent"
          android:layout_height="wrap_content" />
        <Button
          android:id="@+id/btnNewQuote"
          style="@style/ActionSecondary"
          android:text="@string/new_quote"
          android:layout_marginTop="@dimen/space_medium"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content" />
      </LinearLayout>
      <Button
        android:id="@+id/btnFeedback"
        style="@style/ActionSecondary"
        android:text="@string/feedback"
        android:layout_marginTop="@dimen/space_large"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
      <Button
        android:id="@+id/btnPrivacy"
        style="@style/ActionSecondary"
        android:text="@string/privacy_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
    </LinearLayout>
  </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
